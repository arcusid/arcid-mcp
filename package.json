{
  "name": "arcid-mcp",
  "version": "0.2.0",
  "description": "MCP server for ArcID: look up AI agent identity and reputation (ERC-8004) on Arc",
  "type": "module",
  "bin": {
    "arcid-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run typecheck && npm test && wrangler deploy"
  },
  "keywords": [
    "mcp",
    "arc",
    "erc-8004",
    "ai-agents",
    "reputation"
  ],
  "author": "arcusid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcusid/arcid-mcp.git"
  },
  "homepage": "https://github.com/arcusid/arcid-mcp#readme",
  "bugs": {
    "url": "https://github.com/arcusid/arcid-mcp/issues"
  },
  "mcpName": "io.github.arcusid/arcid-mcp",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
